# Application Metadata
APP_NAME="VCE Pali — e-Gram Seva & Financial Ledger"
APP_ENV="production"
DEBUG=False
HOST="0.0.0.0"
PORT=8000

# Security & Sessions (Production 256-bit cryptographic secret key)
SECRET_KEY="replace_with_a_secure_random_key_in_production"

# Regional Formatting
TIMEZONE="Asia/Kolkata"
CURRENCY_SYMBOL="₹"

# Default Operator Credentials
DEFAULT_OPERATOR_ID="akrajput2005"
DEFAULT_OPERATOR_PASS="Akshay@05"

# Cloud Hosting URLs
BACKEND_URL="https://vce-pali-backend.onrender.com"
FRONTEND_URL="https://vce-xi.vercel.app"

# Dedicated API Mode (Set to False to hide UI on backend, True to serve static files locally)
SERVE_FRONTEND=False

# Allowed CORS Origins (wildcard * or comma-separated list of domains)
CORS_ORIGINS="*"

# Database Connection (Leave empty to use local SQLite, or provide PostgreSQL/Supabase URI)
DATABASE_URL="postgresql://postgres.[REF]:[ENCODED_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
