<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.VCEPali" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand colors matching VCE Pali mobile UI -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_hover</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_light</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Backgrounds & Surfaces -->
        <item name="android:colorBackground">@color/bg_canvas</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_main</item>

        <!-- Edge-to-Edge System Bar Tints -->
        <item name="android:statusBarColor">@color/bg_canvas</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bg_surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
    <style name="Theme.VCEGujarat" parent="Theme.VCEPali" />
</resources>